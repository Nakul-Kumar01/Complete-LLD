      "locked": false,
      "text": "M-3 : maintaining session id on server: ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "M-3 : maintaining session id on server: ",
