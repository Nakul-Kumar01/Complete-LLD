    },
    {
      "id": "5SHYt92Jhxlv-QXXovC7Q",
      "type": "text",
      "x": 1384.5910809243774,
      "y": 154.43559991610164,
      "width": 435.0396728515625,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1o",
      "roundness": null,
      "seed": 188208734,
      "version": 40,
      "versionNonce": 1898477802,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1772192900234,
      "link": null,
      "locked": false,
      "text": "Problems:\n\n- Server memory increases with users.\n\n- Hard to scale horizontally:\n\n     If you have multiple servers:\n\n         Server A has session\n\n        Server B doesn’t know about it\n\n- Requires shared session store (Redis/DB).\n\n- Heavy load in large systems.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Problems:\n\n- Server memory increases with users.\n\n- Hard to scale horizontally:\n\n     If you have multiple servers:\n\n         Server A has session\n\n        Server B doesn’t know about it\n\n- Requires shared session store (Redis/DB).\n\n- Heavy load in large systems.",
      "autoResize": true,
      "lineHeight": 1.25
    },
