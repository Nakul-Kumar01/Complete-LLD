      "isDeleted": true,
      "boundElements": [],
      "updated": 1773227200332,
      "link": null,
      "locked": false,
      "text": "Q) hmne aisa kyu nhi kiya ki applience bana lete or light , fan sbb uske\n    methods ko override kr dete.",
