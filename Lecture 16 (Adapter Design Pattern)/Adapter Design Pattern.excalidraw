      "boundElements": [],
      "updated": 1773227200332,
      "link": null,
      "locked": false,
      "text": "UseCases:\n\n- in Text Editor, photoshop  : jisme bhi undo feature chaiye\n\n- Keyboard shortcut i.e. press button -> brightness on/off",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "UseCases:\n\n- in Text Editor, photoshop  : jisme bhi undo feature chaiye\n\n- Keyboard shortcut i.e. press button -> brightness on/off",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "znZl6hrcdBMNiflqsroyY",
      "type": "text",
      "x": 9214.286024887107,
      "y": 194.39376496131965,
      "width": 404.999755859375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKp",
      "roundness": null,
      "seed": 1263860145,
      "version": 48,
      "versionNonce": 144910453,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1773227200332,
      "link": null,
      "locked": false,
      "text": "Encapsulate a Request as an Object,\nthereby letting you parameterize clients\nwith different request, quene or log\nrequest and support undoable operations.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Encapsulate a Request as an Object,\nthereby letting you parameterize clients\nwith different request, quene or log\nrequest and support undoable operations.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
