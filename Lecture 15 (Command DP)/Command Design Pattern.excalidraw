      "isDeleted": false,
      "boundElements": null,
      "updated": 1773147062585,
      "link": null,
      "locked": false,
      "text": "Encapsulate a Request as an Object,\nthereby letting you parameterize clients\nwith different request, quene or log\nrequest and support undoable operations.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Encapsulate a Request as an Object,\nthereby letting you parameterize clients\nwith different request, quene or log\nrequest and support undoable operations.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
