    {
      "id": "pyIEYSxfkMpbFV4prEVbx",
      "type": "text",
      "x": -254.07007703529246,
      "y": 376.863806513497,
      "width": 372.43975830078125,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1b",
      "roundness": null,
      "seed": 1468846486,
      "version": 10,
      "versionNonce": 533686320,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772037227896,
      "link": null,
      "locked": false,
      "text": "2) User Login :\n\nUser enters password.\n\nRetrieve stored salt.\n\nCombine input password + stored salt.\n\nHash again.\n\nCompare with stored hash.\n\nIf match → login success.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2) User Login :\n\nUser enters password.\n\nRetrieve stored salt.\n\nCombine input password + stored salt.\n\nHash again.\n\nCompare with stored hash.\n\nIf match → login success.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2o2Cz5h91_FUmN5GdGAGw",
      "type": "rectangle",
      "x": -1177.1839337359618,
      "y": -539.4199925944324,
      "width": 1676.0375445466761,
      "height": 2155.2878690053176,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1c",
