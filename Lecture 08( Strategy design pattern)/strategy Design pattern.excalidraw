    {
      "id": "1wjLtVLqQpyuYFiYJlpW_",
      "type": "text",
      "x": -877.9253552522528,
      "y": 379.129647806205,
      "width": 426.33966064453125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
