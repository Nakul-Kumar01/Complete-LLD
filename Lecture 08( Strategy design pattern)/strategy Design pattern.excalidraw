      "type": "text",
      "x": 1625.1651375823253,
      "y": 2151.8372209151667,
      "width": 786.939453125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
