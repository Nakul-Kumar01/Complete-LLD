      "link": null,
      "locked": false
    },
    {
      "id": "Al6GWijgZeolCzCpwVvDr",
      "type": "text",
      "x": -1019.2185966388754,
      "y": 955.8944050514908,
      "width": 1404.3616441678173,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1d",
      "roundness": null,
      "seed": 868293706,
      "version": 94,
      "versionNonce": 1276305968,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772037227896,
      "link": null,
      "locked": false,
      "text": "// M-1:\n    const hashpass2 = await bcrypt.hash(password,10); // '10' rounds hai(algo ko 2^10 times run krna) // jitna jyada hoga utna complex hashing\nalgo hogi // ingeneral 10 to 12 hi lete hai\n    console.log(hashpass2);\n\n    //M-2:\n    const salt = await bcrypt.genSalt(10); // salt kuch bhi nhi hai, koi random se characters hai\n    const hashpass = await bcrypt.hash(password,salt); // agr yaha no. of round diya tho ye salt khud generate krega // agr already salt diya,\ntho given salt ko hi use krega\n    console.log(salt);    //$2b$10$mCGstH837wckI.IBVNfSsO\n    console.log(hashpass);//$2b$10$mCGstH837wckI.IBVNfSsOcY5R.h7D6BLFFbn6kPJv6DYiifHxPpe // DB mei ye puri info store hota hai\n                          // 2-version of bcrypt ko use kr rhe hn\n                          // 10-no. of round Implemented\n                          // $- isske baad actual salt present hai na ki usska hash code (22 characters)\n                          // baad vala part actual hash code hai(jo (password + salt) ka hash code hai) (31 characters)\n                          // abb when user login by password: rohit@123, then rohit@123 + it's salt --> abb hashcode find kro 10 rounds ke liye //\nnow match with the stored 31 character, if matched then login successfull else failed\n\n\n    const ans = await bcrypt.compare(password,hashpass); // ye baatega ki aap login ho skte ya nhi // await issliye kyoki password ka\nhashcode bhi tho find hoga, tbb stored hashcode se compare hoga\n    console.log(ans);",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// M-1:\n    const hashpass2 = await bcrypt.hash(password,10); // '10' rounds hai(algo ko 2^10 times run krna) // jitna jyada hoga utna complex hashing algo hogi // ingeneral 10 to 12 hi lete hai\n    console.log(hashpass2);\n\n    //M-2:\n    const salt = await bcrypt.genSalt(10); // salt kuch bhi nhi hai, koi random se characters hai\n    const hashpass = await bcrypt.hash(password,salt); // agr yaha no. of round diya tho ye salt khud generate krega // agr already salt diya, tho given salt ko hi use krega\n    console.log(salt);    //$2b$10$mCGstH837wckI.IBVNfSsO\n    console.log(hashpass);//$2b$10$mCGstH837wckI.IBVNfSsOcY5R.h7D6BLFFbn6kPJv6DYiifHxPpe // DB mei ye puri info store hota hai\n                          // 2-version of bcrypt ko use kr rhe hn\n                          // 10-no. of round Implemented\n                          // $- isske baad actual salt present hai na ki usska hash code (22 characters)\n                          // baad vala part actual hash code hai(jo (password + salt) ka hash code hai) (31 characters)\n                          // abb when user login by password: rohit@123, then rohit@123 + it's salt --> abb hashcode find kro 10 rounds ke liye // now match with the stored 31 character, if matched then login successfull else failed\n\n\n    const ans = await bcrypt.compare(password,hashpass); // ye baatega ki aap login ho skte ya nhi // await issliye kyoki password ka hashcode bhi tho find hoga, tbb stored hashcode se compare hoga\n    console.log(ans);",
      "autoResize": false,
      "lineHeight": 1.25
    },
