      "versionNonce": 2104042544,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772037227896,
      "link": null,
      "locked": false,
      "text": "- Jwt expires : user must login again\n- also if token validity is long, then -> security risk, token is \nstolen then hacker has access, which cannot be revoke even on password change",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Jwt expires : user must login again\n- also if token validity is long, then -> security risk, token is \nstolen then hacker has access, which cannot be revoke even on password change",
      "autoResize": true,
      "lineHeight": 1.25
    },
