      "seed": 1111760138,
      "version": 6,
      "versionNonce": 572829232,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772037227896,
      "link": null,
      "locked": false,
      "text": "Now even if two users have same password:\nUser1: password + salt1 → hash1\nUser2: password + salt2 → hash2\n\nHashes will be completely different.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now even if two users have same password:\nUser1: password + salt1 → hash1\nUser2: password + salt2 → hash2\n\nHashes will be completely different.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "V_JVDaCZKY-IW3MLOkXUb",
      "type": "text",
      "x": -258.6017019979713,
      "y": 308.8892592051003,
