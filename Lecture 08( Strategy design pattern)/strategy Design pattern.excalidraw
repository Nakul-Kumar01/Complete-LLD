      "isDeleted": false,
      "boundElements": [],
      "updated": 1772037227896,
      "link": null,
      "locked": false,
      "text": "Important JWT Limitations\n\nCannot easily revoke before expiry.\n\nIf stolen → valid until expiry.\n\nPayload visible (not encrypted).\n\nNeed HTTPS always.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Important JWT Limitations\n\nCannot easily revoke before expiry.\n\nIf stolen → valid until expiry.\n\nPayload visible (not encrypted).\n\nNeed HTTPS always.",
      "autoResize": true,
      "lineHeight": 1.25
    },
